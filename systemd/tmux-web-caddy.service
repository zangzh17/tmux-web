# Example user unit: the front door on 127.0.0.1:8890 (point your tunnel / reverse proxy at it).
[Unit]
Description=tmux-web: Caddy front door on 127.0.0.1:8890
After=tmux-web-api.service tmux-web-ttyd.service
Wants=tmux-web-api.service tmux-web-ttyd.service

[Service]
Type=notify
Environment=TMUX_WEB_PORT=8890
Environment=TMUX_WEB_RUNTIME=%t/tmux-web
Environment=TMUX_WEB_PUBLIC=%h/tmux-web/public
Environment=XDG_CONFIG_HOME=%h/.config/tmux-web/xdg-config
Environment=XDG_DATA_HOME=%h/.config/tmux-web/xdg-data
ExecStart=%h/.local/bin/caddy run --config %h/tmux-web/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
