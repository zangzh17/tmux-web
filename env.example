# Copy to ~/.config/tmux-web/env (chmod 600). Until BOTH Access settings are set, every request is refused (503).
# Team domain: Cloudflare Zero Trust dashboard -> Settings -> Custom Pages (looks like  yourteam.cloudflareaccess.com).
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Zero Trust -> Access -> Applications -> your app -> Overview.
CF_ACCESS_AUD=
# Optional second check on top of the Access policy: comma-separated emails allowed in.
ALLOWED_EMAILS=
# Set to 0 to hide the last-lines preview on the session list.
#TMUX_WEB_PREVIEW=1
# Multi-user is optional and off unless a users file exists (see "Users and permissions" in the README).
#TMUX_WEB_USERS=%h/.config/tmux-web/users.json
#TMUX_WEB_MULTI_USER=0
